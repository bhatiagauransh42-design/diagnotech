# ==============================================================================
# DiagnoTech — Environment Configuration Template
# Duplicate this file as .env and populate your actual API credentials.
# ==============================================================================

# LLM Provider Configuration (for Clinical AI Assistant & Lab Report Parsing)
MODEL_PROVIDER=openrouter
MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative Direct OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://diagnotech-chi.vercel.app
